{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Netrex",
  "version": "0.0.1",
  "identifier": "com.netrex.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3100",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Netrex",
        "width": 1200,
        "height": 800,
        "backgroundColor": "#1e1e1e",
        "center": true,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --disable-renderer-backgrounding --disable-backgrounding-occluded-windows --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob: https:; connect-src 'self' ipc: http://ipc.localhost https: wss: ws: blob: data:; img-src 'self' data: blob: https: http:; media-src 'self' data: blob: https: http:; font-src 'self' data: https:; style-src 'self' 'unsafe-inline' https:; worker-src 'self' blob:; frame-src https:; object-src 'none'; base-uri 'self'; form-action 'self'",
      "devCsp": "default-src * 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' data: blob: ws: wss: http: https: ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Netrex",
    "shortDescription": "Netrex - Güvenli Sesli Sohbet",
    "category": "SocialNetworking",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Turkish",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwNURBRTI2RDc5MTAzQjkKUldTNUE1SFhKcTVkUUx6K2V1VHEwMVZlb0F3bnF2eW5McmFDY1Q4QnE0MWsyZ3VjNWlOeXBPNTgK"
    }
  }
}
