rules_version = '2';

// ============================================================================
// NETREX — Firestore güvenlik kuralları
// ----------------------------------------------------------------------------
// Genel ilke:
//   • Giriş yapmamış kimse hiçbir şeye erişemez.
//   • Sunucu verisini yalnızca o sunucunun üyeleri okur.
//   • Yönetim işlemleri (ayar, kanal, rol, atma, yasaklama, susturma) ROL İZNİYLE yapılır; izinler burada denetlenir.
//   • Sunucuya katılmak geçerli bir davet kodu gerektirir; yasaklı kullanıcı katılamaz, kimse kendine rol veremez.
//   • Sunucunun sahibi (ownerId) değiştirilemez; sunucuyu yalnızca sahibi siler.
//   • Mesajı yalnızca yazarı düzenler; başkası adına mesaj yazılamaz.
//   • DM konuşmaları yalnızca katılımcılara, arkadaşlık kayıtları yalnızca taraflara açıktır.
//
// Rol izinleri nasıl denetleniyor?
//   Kurallar bir koleksiyonu dolaşamaz, bu yüzden "hangi izin hangi rollerde" bilgisi tek bir belgede tutulur:
//     servers/{sid}/meta/perms = { MANAGE_CHANNELS: [rolId, ...], KICK_MEMBERS: [...], ... }
//   Bu belgeyi rol düzenleyen istemci günceller (src/store/serverStore.js > syncPermsIndex) ve yalnızca
//   MANAGE_ROLES izni olanlar (ya da sahip) yazabilir. Belge yoksa yalnızca sahip yönetebilir.
//
// BİLİNEN SINIRLAR:
//   • MANAGE_ROLES izni olan biri kendine başka izinler de verebilir (rol hiyerarşisi yok): bu izin "yönetici" sayılmalı.
//   • Kanal bazlı "görme" izinleri (permissionOverwrites) istemcide uygulanır; üyeler tüm kanalların mesajını okuyabilir.
//   • Engellenen kullanıcının DM açması kuralla engellenmez (arkadaşlık belgelerinin kimliği tahmin edilebilir değil).
//   • Giriş yapmış herkes `users` belgelerini okuyabilir (arkadaş arama ve üye listesi için gerekli). Bu belgelerde
//     e-posta TUTULMAZ (istemci artık yazmıyor, girişte eski kaydı siliyor).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────── Yardımcılar ─────────
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function serverData(sid) {
      return get(/databases/$(database)/documents/servers/$(sid)).data;
    }

    function isServerMember(sid) {
      return signedIn()
        && exists(/databases/$(database)/documents/servers/$(sid)/members/$(request.auth.uid));
    }

    function isServerOwner(sid) {
      return signedIn() && serverData(sid).ownerId == request.auth.uid;
    }

    // Sahip her izne sahiptir. Diğerleri: üye olmalı ve rollerinden biri izin dizininde bu izne kayıtlı olmalı.
    function hasPerm(sid, perm) {
      return isServerOwner(sid)
        || (isServerMember(sid)
            && exists(/databases/$(database)/documents/servers/$(sid)/meta/perms)
            && get(/databases/$(database)/documents/servers/$(sid)/meta/perms).data.get(perm, [])
                 .hasAny(get(/databases/$(database)/documents/servers/$(sid)/members/$(request.auth.uid)).data.get('roles', [])));
    }

    // Güncellemede yalnızca verilen alanlar değişiyor mu?
    function changesOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function changesNone(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    function isDmParticipant(cid) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/dm_conversations/$(cid)).data.participantIds;
    }

    // ───────── Kullanıcılar ─────────
    match /users/{uid} {
      allow get: if signedIn();
      // Toplu döküm olmasın: listeleme (üye listesi parçaları, arkadaş arama) en çok 30 belge ister
      allow list: if signedIn() && request.query.limit <= 30;
      allow create: if isSelf(uid);
      // Sahibi yazar; e-posta alanı sonradan eklenemez/değiştirilemez, yalnızca silinebilir (eski sürümlerin yazdığı
      // kayıt girişte temizlenir). Başkası yalnızca "sesli kanaldan at" temizliği için currentRoom / gameActivity
      // alanlarını BOŞALTABİLİR (sahte etkinlik yazamaz).
      allow update: if (isSelf(uid) && (changesNone(['email']) || !('email' in request.resource.data)))
        || (signedIn()
            && changesOnly(['currentRoom', 'gameActivity'])
            && request.resource.data.get('currentRoom', null) == null
            && request.resource.data.get('gameActivity', null) == null);
      allow delete: if isSelf(uid);

      // users/{uid}/spatialSettings/* gibi alt belgeler: yalnızca sahibi
      match /{sub}/{docId} {
        allow read, write: if isSelf(uid);
      }
    }

    // ───────── Sunucular ─────────
    match /servers/{sid} {
      // Tek bir sunucuyu okumak: davetle katılmadan önce de gerekir. Listeleme: yalnızca üyesi olduklarım.
      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];

      allow update: if signedIn() && (
        // Sahip: sahiplik dışında her şey
        (resource.data.ownerId == request.auth.uid && changesNone(['ownerId']))
        // Yönetici: üye listesi ve sahiplik dışındaki ayarlar
        || (changesNone(['ownerId', 'memberIds', 'createdAt']) && hasPerm(sid, 'MANAGE_SERVER'))
        // Katılma: yalnızca kendini ekler ve aynı işlemde (batch) geçerli bir üyelik belgesi oluşmuş olmalı
        || (changesOnly(['memberIds'])
            && request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()).hasOnly([request.auth.uid])
            && resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet()).size() == 0
            && existsAfter(/databases/$(database)/documents/servers/$(sid)/members/$(request.auth.uid)))
        // Ayrılma: yalnızca kendini çıkarır
        || (changesOnly(['memberIds'])
            && request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()).size() == 0
            && resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet()).hasOnly([request.auth.uid]))
        // Atma / yasaklama: tek bir üyeyi çıkarır (sahip çıkarılamaz)
        || (changesOnly(['memberIds'])
            && request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()).size() == 0
            && resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet()).size() == 1
            && resource.data.ownerId in request.resource.data.memberIds
            && (hasPerm(sid, 'KICK_MEMBERS') || hasPerm(sid, 'BAN_MEMBERS')))
      );

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // ── İzin dizini (bkz. dosya başı) ──
      match /meta/{docId} {
        allow read: if isServerMember(sid) || isServerOwner(sid);
        allow write: if hasPerm(sid, 'MANAGE_ROLES');
      }

      // ── Roller ──
      match /roles/{roleId} {
        allow read: if isServerMember(sid) || isServerOwner(sid);
        allow write: if hasPerm(sid, 'MANAGE_ROLES');
      }

      // ── Rozetler ──
      match /badges/{badgeId} {
        allow read: if isServerMember(sid) || isServerOwner(sid);
        allow write: if hasPerm(sid, 'MANAGE_SERVER');
      }

      // ── Kanallar ──
      match /channels/{cid} {
        allow read: if isServerMember(sid) || isServerOwner(sid);
        allow write: if hasPerm(sid, 'MANAGE_CHANNELS');

        // Mesajlar. İki biçim var:
        //   eski  : belge = tek mesaj            { userId, text, timestamp, ... }
        //   toplu : belge = bir yazarın mesajları { userId, items: [ {id, text, timestamp, ...} ], reactions: {mesajId: {...}} }
        match /messages/{mid} {
          allow read: if isServerMember(sid);
          allow create: if isServerMember(sid)
            && request.resource.data.userId == request.auth.uid
            && (!('items' in request.resource.data)
                || (request.resource.data.items is list && request.resource.data.items.size() <= 40));
          allow update: if isServerMember(sid) && (
            // Yazar: içeriği düzenler (yazar kimliği değişmez)
            (resource.data.userId == request.auth.uid && changesNone(['userId']))
            // Herkes: yalnızca tepkiler
            || changesOnly(['reactions'])
            // Yetkili: toplu belgeden mesaj çıkarır
            || (changesOnly(['items']) && hasPerm(sid, 'MANAGE_CHANNELS'))
          );
          allow delete: if isServerMember(sid)
            && (resource.data.userId == request.auth.uid || hasPerm(sid, 'MANAGE_CHANNELS'));
        }

        // Watch Party oturumu: odadaki üyeler birlikte yönetir (oy, liste, oynatma)
        match /watchParty/{docId} {
          allow read, write: if isServerMember(sid);
        }
      }

      // ── Üyelik ──
      match /members/{memberId} {
        // Kendi kaydım (katılmadan önce "zaten üye miyim?") ya da aynı sunucunun üyeleri
        allow get: if isSelf(memberId) || isServerMember(sid);
        allow list: if isServerMember(sid) || isServerOwner(sid);

        allow create: if isSelf(memberId)
          && !request.resource.data.keys().hasAny(
               ['badges', 'isMutedByServer', 'mutedBy', 'mutedAt', 'isDeafenedByServer', 'deafenedBy', 'deafenedAt'])
          && (
            // Sunucuyu kuran kişi
            isServerOwner(sid)
            // Davetle katılan: yasaklı değil, davet bu sunucuya ait, süresi/limiti dolmamış, aynı işlemde
            // kullanım sayısı 1 artıyor ve en fazla varsayılan rol alınıyor
            || (!exists(/databases/$(database)/documents/servers/$(sid)/bans/$(request.auth.uid))
                && request.resource.data.inviteCode is string
                && validInvite(sid, request.resource.data.inviteCode)
                && joinRolesOk(sid, request.resource.data.get('roles', [])))
          );

        allow update: if signedIn() && (
          // Kendi kaydım: rol, rozet ve sunucu susturma alanlarına dokunamam
          (isSelf(memberId)
            && changesNone(['roles', 'badges', 'inviteCode', 'isMutedByServer', 'mutedBy', 'mutedAt',
                            'isDeafenedByServer', 'deafenedBy', 'deafenedAt']))
          || (changesOnly(['roles']) && hasPerm(sid, 'MANAGE_ROLES'))
          || (changesOnly(['badges']) && hasPerm(sid, 'MANAGE_SERVER'))
          || (changesOnly(['isMutedByServer', 'mutedBy', 'mutedAt']) && hasPerm(sid, 'MUTE_MEMBERS'))
          || (changesOnly(['isDeafenedByServer', 'deafenedBy', 'deafenedAt']) && hasPerm(sid, 'DEAFEN_MEMBERS'))
        );

        // Ayrılma (kendim) ya da atma/yasaklama (yetkili; sahip atılamaz)
        allow delete: if isSelf(memberId)
          || (serverData(sid).ownerId != memberId
              && (hasPerm(sid, 'KICK_MEMBERS') || hasPerm(sid, 'BAN_MEMBERS')));
      }

      function validInvite(sid, code) {
        let inv = get(/databases/$(database)/documents/invites/$(code)).data;
        return inv.serverId == sid
          && (inv.get('expiresAt', null) == null || inv.expiresAt > request.time)
          && (inv.get('maxUses', 0) == 0 || inv.uses < inv.maxUses)
          && getAfter(/databases/$(database)/documents/invites/$(code)).data.uses == inv.uses + 1;
      }

      function joinRolesOk(sid, roles) {
        return roles.size() == 0
          || (roles.size() == 1 && roles[0] == serverData(sid).get('defaultRoleId', ''));
      }

      // ── Yasaklar ──
      match /bans/{banId} {
        allow get: if isSelf(banId) || hasPerm(sid, 'BAN_MEMBERS');
        allow list: if hasPerm(sid, 'BAN_MEMBERS');
        allow write: if hasPerm(sid, 'BAN_MEMBERS');
      }

      // ── Davetlerin sunucu içi kopyası (ayarlar > davetler listesi) ──
      match /invites/{code} {
        allow read: if isServerMember(sid) || isServerOwner(sid);
        allow create: if isServerMember(sid) && request.resource.data.creatorId == request.auth.uid;
        // Katılan kişi yalnızca kullanım sayısını 1 artırır
        allow update: if (signedIn() && changesOnly(['uses']) && request.resource.data.uses == resource.data.uses + 1)
          || hasPerm(sid, 'MANAGE_SERVER');
        allow delete: if hasPerm(sid, 'MANAGE_SERVER')
          || (isServerMember(sid) && resource.data.creatorId == request.auth.uid);
      }
    }

    // ───────── Davet kodları (üst düzey) ─────────
    match /invites/{code} {
      allow get: if signedIn();            // kodu bilen okuyabilir; tüm kodları listelemek yasak
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.uses == 0
        && (isServerMember(request.resource.data.serverId) || isServerOwner(request.resource.data.serverId));
      // Katılan kişi kullanım sayısını tam 1 artırır; yöneticiler diğer alanları değiştirebilir (sunucu sabit)
      allow update: if signedIn() && (
        (changesOnly(['uses']) && request.resource.data.uses == resource.data.uses + 1)
        || (changesNone(['serverId']) && hasPerm(resource.data.serverId, 'MANAGE_SERVER'))
      );
      allow delete: if signedIn()
        && (resource.data.creatorId == request.auth.uid || hasPerm(resource.data.serverId, 'MANAGE_SERVER'));
    }

    // ───────── Arkadaşlıklar ─────────
    match /friendships/{id} {
      allow read: if signedIn()
        && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId is string
        && request.resource.data.receiverId != request.auth.uid
        && (request.resource.data.status == 'pending'
            || (request.resource.data.status == 'blocked' && request.resource.data.blockedBy == request.auth.uid));
      allow update: if signedIn()
        && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid)
        && changesNone(['senderId', 'receiverId'])
        && (
          // Kabul: yalnızca isteği ALAN kişi, bekleyen isteği kabul eder
          (request.resource.data.status == 'accepted'
            && resource.data.status == 'pending'
            && resource.data.receiverId == request.auth.uid)
          // Engelleme: engelleyen kendisi olarak işaretlenir (başkasının engelini devralamaz)
          || (request.resource.data.status == 'blocked'
              && request.resource.data.blockedBy == request.auth.uid
              && (resource.data.status != 'blocked' || resource.data.get('blockedBy', request.auth.uid) == request.auth.uid))
        );
      // Engeli yalnızca engelleyen kaldırır; diğer kayıtları iki taraf da silebilir
      allow delete: if signedIn()
        && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid)
        && (resource.data.status != 'blocked'
            || resource.data.get('blockedBy', request.auth.uid) == request.auth.uid);
    }

    // ───────── Direkt mesajlar ─────────
    match /dm_conversations/{cid} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && changesNone(['participantIds']);
      allow delete: if signedIn() && request.auth.uid in resource.data.participantIds;

      match /messages/{mid} {
        allow read: if isDmParticipant(cid);
        allow create: if isDmParticipant(cid) && request.resource.data.senderId == request.auth.uid;
        // Yazar düzenler; karşı taraf yalnızca tepki ekler/kaldırır
        allow update: if isDmParticipant(cid)
          && ((resource.data.senderId == request.auth.uid && changesNone(['senderId']))
              || changesOnly(['reactions']));
        // "Sohbeti temizle" iki tarafın mesajlarını da siler
        allow delete: if isDmParticipant(cid);
      }
    }

    // ───────── LiveKit sunucu havuzu (yalnızca aktif sunucu sırası; gizli bilgi yok) ─────────
    // Herkes okur. Yazma: kota dolunca istemci sıradaki sunucuya geçer. Kötüye kullanımı sınırlamak için
    // sıra yalnızca BİR SONRAKİ sunucuya (ya da onarım için 0'a) alınabilir ve iki geçiş arasında en az 20 sn olmalıdır.
    match /system/livekitPool {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.activeServerIndex == 0
        && request.resource.data.serverCount is int
        && request.resource.data.serverCount >= 1
        && request.resource.data.serverCount <= 20;
      allow update: if signedIn()
        && changesNone(['createdAt'])
        && request.resource.data.activeServerIndex is int
        && request.resource.data.activeServerIndex >= 0
        && request.resource.data.activeServerIndex < 20
        && request.resource.data.lastRotation == request.time
        && (request.resource.data.activeServerIndex == 0
            || request.resource.data.activeServerIndex == resource.data.activeServerIndex + 1)
        && (!(resource.data.get('lastRotation', null) is timestamp)
            || request.time > resource.data.lastRotation + duration.value(20, 's'));
    }

    // Yukarıda tanımlanmayan her şey kapalı (eski `rooms`, `text_channels`, `tabletop_mods` dahil)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
