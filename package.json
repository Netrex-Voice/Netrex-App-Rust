{
  "name": "netrex-native",
  "version": "0.0.2",
  "description": "Secure Desktop Voice Chat Application",
  "homepage": "./",
  "scripts": {
    "dev": "next dev -p 3100",
    "dev:web": "cross-env NEXT_PUBLIC_BUILD_TARGET=web next dev",
    "build": "next build",
    "lint": "next lint",
    "test": "npm run test:unit && npm run test:games",
    "test:unit": "node --test \"src/**/__tests__/*.unit.test.mjs\"",
    "test:games": "node --test src/modules/games/__tests__/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore,database --project demo-netrex \"node --test rules-tests/*.test.mjs\"",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@livekit/components-react": "^2.9.25",
    "@livekit/components-styles": "^1.2.0",
    "@tauri-apps/api": "^2",
    "@timephy/rnnoise-wasm": "^1.0.0",
    "browser-image-compression": "^2.0.2",
    "emoji-picker-react": "^4.16.1",
    "firebase": "^11.0.2",
    "framer-motion": "^12.23.26",
    "immer": "^11.1.3",
    "livekit-client": "^2.23.0",
    "lucide-react": "^0.563.0",
    "next": "^14.2.16",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-player": "^3.4.0",
    "react-virtuoso": "^4.18.1",
    "sonner": "^2.0.7",
    "three": "^0.186.1",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2",
    "autoprefixer": "^10.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.16",
    "firebase-tools": "^13.29.1",
    "postcss": "^8",
    "tailwindcss": "^3.3.0"
  }
}
