# Bu değerler Vercel panelinde (Project > Settings > Environment Variables) girilir; dosyaya YAZILIP commit EDİLMEZ.

# Firebase proje kimliği (herkese açık; ID token doğrulaması için)
FIREBASE_PROJECT_ID=

# LiveKit sunucu havuzu (i = 0..19)
LIVEKIT_SERVERS_0_URL=wss://...
LIVEKIT_SERVERS_0_KEY=
LIVEKIT_SERVERS_0_SECRET=
# LIVEKIT_SERVERS_1_URL=... (aynı şekilde devam)

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# İsteğe bağlı: virgülle ayrılmış ek CORS origin'leri (uygulamanın kendi origin'leri zaten izinli)
# ALLOWED_ORIGINS=
